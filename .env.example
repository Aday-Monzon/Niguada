POSTGRES_DB=niguada
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432

BACKEND_PORT=4000
NODE_ENV=production
DATABASE_URL=postgresql://postgres:replace-with-local-postgres-password@postgres:5432/niguada
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:8080

FRONTEND_PORT=8080
VITE_API_URL=/api/v1

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-demo-admin-password
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_SECOND_EMPLOYEE_EMAIL=employee2@example.com
SEED_EMPLOYEE_PASSWORD=replace-with-demo-employee-password
